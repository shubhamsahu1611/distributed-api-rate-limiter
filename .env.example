# HTTP server
PORT=8080

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# TOKEN_BUCKET or SLIDING_WINDOW
ACTIVE_ALGORITHM=TOKEN_BUCKET

# Requests allowed per RATE_LIMIT_WINDOW
RATE_LIMIT_WINDOW=1m
FREE_LIMIT=10
PREMIUM_LIMIT=100

# Demo credentials. Replace these values outside local development.
FREE_API_KEY=free_demo_key
PREMIUM_API_KEY=premium_demo_key

# false protects the API when Redis is unavailable; true prioritizes availability.
FAIL_OPEN=false
